<?xml version="1.0" ?>
<robot name="simple_extruder">
  <link name="extruder_body">
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="1e-5" iyy="1e-5" izz="1e-5" ixy="0" ixz="0" iyz="0"/>
      <origin xyz="0 0 0.05"/>
    </inertial>
    <visual>
      <geometry>
        <cylinder radius="0.01" length="0.1"/>
      </geometry>
      <material name="gray">
        <color rgba="0.5 0.5 0.5 1"/>
      </material>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
    </visual>
  </link>
</robot>